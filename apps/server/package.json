{
  "name": "@gier/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "tsx --env-file-if-exists=../../.env src/demo.ts"
  },
  "dependencies": {
    "@gier/core": "workspace:*",
    "@gier/db": "workspace:*",
    "@gier/relay-protocol": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "vitest": "^5.1.1"
  }
}
