# Gier configuration. Copy to .env and fill in only what you use; everything is optional.
# Used by `pnpm dev` and by `docker compose`. Costs are usage-based only (no subscriptions).

# --- Basics ---------------------------------------------------------------
PORT=8787
# Public address, used for links in notifications.
GIER_PUBLIC_URL=http://localhost:8787
# Only when serving Gier below a path behind a reverse proxy, e.g. /gier. Empty = site root.
GIER_BASE_PATH=
# Language for notifications until the app reports yours (en, nl).
GIER_LANGUAGE=en
# Encrypts stored shop sessions. Leave empty to have Gier generate one in the data folder (secrets.json).
GIER_SECRET=
DATABASE_FILE=./data/gier.db

# --- Search (ADR-005) -----------------------------------------------------
# Self-hosted SearXNG with JSON output enabled (deploy/searxng/settings.yml). Free.
# docker compose sets SEARXNG_URL to its own SearXNG container.
SEARXNG_URL=http://localhost:8080
# Optional fallback, pay per query, hard monthly cap in USD.
BRAVE_API_KEY=
BRAVE_MONTHLY_CAP_USD=5

# --- AI (ADR-009) ---------------------------------------------------------
# Claude Haiku for recognising products, doubtful matches and buying advice. Pay per token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_MONTHLY_CAP_EUR=2

# --- Cloudflare Browser Run (ADR-006, ADR-014) -----------------------------
# JavaScript-heavy shops and the login handoff. Token needs "Browser Run: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Notifications (ADR-011) ----------------------------------------------
# Web Push: leave empty to have Gier generate a key pair in the data folder (secrets.json).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Telegram fallback: create a bot with @BotFather, then message it and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (self-hosted or ntfy.sh topic URL)
NTFY_URL=
NTFY_TOKEN=
# Home Assistant webhook automation
HOME_ASSISTANT_WEBHOOK_URL=

